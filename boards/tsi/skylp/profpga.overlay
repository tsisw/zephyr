 *
 * ProFPGA (Siemens M85) console overlay.
 *
 * The board default routes the Zephyr console/shell to the Altera JTAG UART
 * (jtag_uart), which is only present on the Bittware (Intel FPGA) platform.
 * ProFPGA has no Altera JTAG UART, so this overlay repoints the console/shell
 * to the IONE PL011 uart0 at 0x86001000.
 *
 * Apply with:
 *   west build -b tsi_skylp/skylp/m85 tsi_core -- \
 *       -DOVERLAY_CONFIG=prj_poll.conf \
 *       -DEXTRA_DTC_OVERLAY_FILE=boards/tsi/skylp/profpga.overlay
 */

/ {
	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};
};

/*
 * ProFPGA has no Altera JTAG UART. Disable the jtag_uart node so its driver
 * (uart_altera_jtag) does not init/access 0x86003000, which faults/hangs boot
 * on ProFPGA. (On Bittware the IP exists, so the board default leaves it on.)
 */
&jtag_uart {
	status = "disabled";
};
