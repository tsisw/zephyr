/*
 * GMC Zephyr memory map for dual-QEMU (shared guest_mem @ 0x60000000, 4 MiB).
 *
 * Link at TSI_NONSECURE_BASE (0x60100000) per architecture wiki. Mailbox SHM
 * at 0x6014F000 (last 4 KiB of the 320 KiB NS slot).
 */

&sram0 {
	reg = <0x60100000 DT_SIZE_K(128)>;
};

/* NS code + data through end of NS slot (0x60150000); SHM at 0x6014F000. */
&sram {
	reg = <0x60120000 0x00030000>;
};
