diff --git a/boards/tsi/skylp/profpga.overlay b/boards/tsi/skylp/profpga.overlay
new file mode 100644
index 00000000000..7d6bf1a1334
--- /dev/null
+++ b/boards/tsi/skylp/profpga.overlay
@@ -0,0 +1,23 @@
+/*
+ * Copyright (c) 2026 TSI
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * ProFPGA (Siemens M85) console overlay.
+ *
+ * The board default routes the Zephyr console/shell to the Altera JTAG UART
+ * (jtag_uart), which is only present on the Bittware (Intel FPGA) platform.
+ * ProFPGA has no Altera JTAG UART, so this overlay repoints the console/shell
+ * to the IONE PL011 uart0 at 0x86001000.
+ *
+ * Apply with:
+ *   west build -b tsi_skylp/skylp/m85 tsi_core -- \
+ *       -DOVERLAY_CONFIG=prj_poll.conf \
+ *       -DEXTRA_DTC_OVERLAY_FILE=boards/tsi/skylp/profpga.overlay
+ */
+
+/ {
+	chosen {
+		zephyr,console = &uart0;
+		zephyr,shell-uart = &uart0;
+	};
+};
diff --git a/boards/tsi/skylp/tsi_skylp_m85.dts b/boards/tsi/skylp/tsi_skylp_m85.dts
index cf462172686..51a1f0b4c85 100644
--- a/boards/tsi/skylp/tsi_skylp_m85.dts
+++ b/boards/tsi/skylp/tsi_skylp_m85.dts
@@ -18,6 +18,9 @@
 	#size-cells = <1>;
 
 	chosen {
+		/* Default console: JTAG UART (Bittware). ProFPGA builds override
+		 * this to &uart0 (PL011) via boards/tsi/skylp/profpga.overlay.
+		 */
 		zephyr,console = &jtag_uart;
 		zephyr,shell-uart = &jtag_uart;
 		zephyr,sram = &sram;
@@ -30,6 +33,32 @@
 		status = "enabled";
 	};
 
+	uartclk: uartclk {
+		compatible = "fixed-clock";
+		clock-frequency = <25000000>;
+		#clock-cells = <0>;
+	};
+
+	uart0: uart@86001000 {
+		compatible = "arm,pl011";
+		reg = <0x86001000 0x1000>;
+		interrupts = <36 3>;    /* unused in polled mode (CONFIG_UART_INTERRUPT_DRIVEN off) */
+		interrupt-parent = <&nvic>;
+		clocks = <&uartclk>;
+		current-speed = <115200>;
+		status = "okay";
+	};
+
+	uart1: uart@86002000 {
+		compatible = "arm,pl011";
+		reg = <0x86002000 0x1000>;
+		interrupts = <37 3>;    /* unused in polled mode */
+		interrupt-parent = <&nvic>;
+		clocks = <&uartclk>;
+		current-speed = <115200>;
+		status = "okay";
+	};
+
 	cpus {
 		#address-cells = <1>;
 		#size-cells = <0>;
